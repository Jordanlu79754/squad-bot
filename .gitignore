# Ignore the virtual environment directory
venv/

# Ignore the .env file containing sensitive data
.env

# Ignore Python cache files
__pycache__/

# Ignore logs and temporary files
*.log
*.tmp

# Ignore IDE or editor-specific files (for example, VSCode)
.vscode/

# Ignore system-specific files (e.g., macOS)
.DS_Store
# Virtualenvs
.venv/

# Runtime state written by the Helldivers / patch notes cogs
bot_state.json

# YouTube session cookies -- never commit these
*cookies.txt

# Audio downloaded by the music player
downloads/
*.mp3
*.webm
*.m4a
*.opus
